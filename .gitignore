# Generated by Cargo
# will have compiled files and executables
**/target/

# Cargo.lock is tracked. A library's lockfile is ignored by downstream consumers, so this only
# affects our own builds — where it buys reproducible CI, which the MSRV job needs (`--locked`).
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# macOS files
.DS_Store
/.idea
/.vscode
.devenv/
.direnv/
node_modules/
dist/
/web-app/src/wasm
/web-app/package-lock.json
