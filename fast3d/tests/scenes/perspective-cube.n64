// perspective-cube — hello-3D: a Gouraud cube under real perspective + a Z-buffer, spinning about Y.
// No backface cull: all 12 tris draw and the Z-buffer (G_ZBUFFER) sorts front vs. back faces.
Mtx proj  = perspective(45, 1.3333, 10, 1000, 1)
Mtx view  = lookat(0, 0, 150, 0, 0, 0, 0, 1, 0)
Mtx model = identity()
Vp { 640, 480, 511, 0, 640, 480, 511, 0 }
Vtx { -30, -30, -30, 0, 0, 0, 255,   0,   0, 255 }
Vtx {  30, -30, -30, 0, 0, 0,   0, 255,   0, 255 }
Vtx {  30,  30, -30, 0, 0, 0,   0,   0, 255, 255 }
Vtx { -30,  30, -30, 0, 0, 0, 255, 255,   0, 255 }
Vtx { -30, -30,  30, 0, 0, 0, 255,   0, 255, 255 }
Vtx {  30, -30,  30, 0, 0, 0,   0, 255, 255, 255 }
Vtx {  30,  30,  30, 0, 0, 0, 255, 255, 255, 255 }
Vtx { -30,  30,  30, 0, 0, 0,  64,  64,  64, 255 }
update {
  guRotate(model, time * 45, 0, 1, 0)
}
gsSPMatrix(proj, G_MTX_PROJECTION | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPPerspNormalize(proj)
gsSPMatrix(view, G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPMatrix(model, G_MTX_MODELVIEW | G_MTX_MUL | G_MTX_NOPUSH)
gsSPViewport(vp)
gsSPSetGeometryMode(G_SHADE | G_SHADING_SMOOTH | G_ZBUFFER)
gsDPSetOtherMode_H(G_CYC_1CYCLE)
gsDPSetRenderMode(G_RM_AA_ZB_OPA_SURF, G_RM_AA_ZB_OPA_SURF2)
gsDPSetCombineLERP(0, 0, 0, SHADE, 0, 0, 0, SHADE, 0, 0, 0, SHADE, 0, 0, 0, SHADE)
gsSPVertex(verts, 8, 0)
gsSP2Triangles(0, 1, 2, 0, 0, 2, 3, 0)
gsSP2Triangles(4, 5, 6, 0, 4, 6, 7, 0)
gsSP2Triangles(0, 1, 5, 0, 0, 5, 4, 0)
gsSP2Triangles(3, 2, 6, 0, 3, 6, 7, 0)
gsSP2Triangles(0, 3, 7, 0, 0, 7, 4, 0)
gsSP2Triangles(1, 2, 6, 0, 1, 6, 5, 0)
gsSPEndDisplayList()
