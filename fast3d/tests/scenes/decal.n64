// decal — coplanar decal + occlusion demo (Phase E complete).
// A full-screen BASE quad (G_RM_AA_ZB_OPA_SURF, z-write) is blue. A COPLANAR decal quad
// (G_RM_AA_ZB_OPA_DECAL, same z=0) covers the TOP HALF in yellow: it shows ON the base with NO
// z-fighting, because the decal fragment does an in-shader coplanar test against the depth the
// opaque pass wrote (NDC-space tolerance, not the ROP's Z test). A NEARER opaque quad (red,
// z=-48) covers the upper-right quadrant and OCCLUDES the decal there — the in-shader Z_CMP
// discards the decal where the red quad is in front, so that region shows red, not yellow.
Mtx proj = scale(0.0078125)
Mtx model = identity()
Vp { 640, 480, 511, 0, 640, 480, 511, 0 }
// Base — full screen, blue, coplanar plane z=0 (writes depth).
Vtx { -128, -128, 0, 0, 0, 0,  40,  40, 200, 255 }
Vtx {  128, -128, 0, 0, 0, 0,  40,  40, 200, 255 }
Vtx {  128,  128, 0, 0, 0, 0,  40,  40, 200, 255 }
Vtx { -128,  128, 0, 0, 0, 0,  40,  40, 200, 255 }
// Decal — top half (y 0..128), yellow, coplanar with the base (z=0).
Vtx { -128,    0, 0, 0, 0, 0, 240, 220,  40, 255 }
Vtx {  128,    0, 0, 0, 0, 0, 240, 220,  40, 255 }
Vtx {  128,  128, 0, 0, 0, 0, 240, 220,  40, 255 }
Vtx { -128,  128, 0, 0, 0, 0, 240, 220,  40, 255 }
// Occluder — upper-right quadrant (x 0..128, y 0..128), red, NEARER (z=-48).
Vtx {    0,    0, -48, 0, 0, 0, 220,  40,  40, 255 }
Vtx {  128,    0, -48, 0, 0, 0, 220,  40,  40, 255 }
Vtx {  128,  128, -48, 0, 0, 0, 220,  40,  40, 255 }
Vtx {    0,  128, -48, 0, 0, 0, 220,  40,  40, 255 }
gsSPMatrix(proj, G_MTX_PROJECTION | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPMatrix(model, G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPViewport(vp)
gsSPSetGeometryMode(G_SHADE | G_SHADING_SMOOTH)
gsDPSetOtherMode_H(G_CYC_1CYCLE)
gsDPSetCombineLERP(0, 0, 0, SHADE, 0, 0, 0, SHADE, 0, 0, 0, SHADE, 0, 0, 0, SHADE)
gsSPVertex(verts, 12, 0)
// Opaque pass: base (z=0) then the nearer occluder (z=-48) — both write depth.
gsDPSetRenderMode(G_RM_AA_ZB_OPA_SURF, G_RM_AA_ZB_OPA_SURF2)
gsSP1Triangle(0, 1, 2, 0)
gsSP1Triangle(0, 2, 3, 0)
gsSP1Triangle(8, 9, 10, 0)
gsSP1Triangle(8, 10, 11, 0)
// Decal pass: coplanar yellow decal — in-shader coplanar (no z-fight) + Z_CMP occlusion.
gsDPSetRenderMode(G_RM_AA_ZB_OPA_DECAL, G_RM_AA_ZB_OPA_DECAL2)
gsSP1Triangle(4, 5, 6, 0)
gsSP1Triangle(4, 6, 7, 0)
gsSPEndDisplayList()
