// ia16-ramp — IA16 (16-bit intensity+alpha) texture format demo: via G_IM_FMT_IA / G_IM_SIZ_16b.
// The RGBA8 source texture is converted to 8-bit intensity + 8-bit alpha by the assembler.
// Combiner: (ONE - 0) * TEXEL0_ALPHA + 0  →  alpha channel rendered as grayscale (RGB output).
// Alpha varies vertically (smooth 8-bit ramp, top→bottom), distinct from the I-format intensity ramp.
Texture tex = { 32, 32, IA16 }
Mtx proj = scale(0.0078125)
Mtx model = identity()
Vp { 640, 480, 511, 0, 640, 480, 511, 0 }
Vtx { -48, -48, 0, 0,    0,    0, 255,255,255,255 }
Vtx {  48, -48, 0, 0, 1024,    0, 255,255,255,255 }
Vtx {  48,  48, 0, 0, 1024, 1024, 255,255,255,255 }
Vtx { -48,  48, 0, 0,    0, 1024, 255,255,255,255 }
gsSPMatrix(proj, G_MTX_PROJECTION | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPMatrix(model, G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPViewport(vp)
gsSPSetGeometryMode(G_SHADE | G_SHADING_SMOOTH)
gsDPSetOtherMode_H(G_CYC_1CYCLE)
gsDPSetRenderMode(G_RM_OPA_SURF, G_RM_OPA_SURF2)
gsDPSetCombineLERP(TEXEL0, 0, SHADE, 0, 0, 0, 0, SHADE, TEXEL0, 0, SHADE, 0, 0, 0, 0, SHADE)
gsDPSetPrimColor(0, 0, 255, 255, 255, 255)
gsDPSetEnvColor(0, 0, 0, 255)
gsDPLoadTextureBlock(tex, G_IM_FMT_IA, G_IM_SIZ_16b, 32, 32)
gsSPTexture(0xFFFF, 0xFFFF, 0, G_TX_RENDERTILE, G_ON)
gsSPVertex(verts, 4, 0)
gsSP1Triangle(0, 1, 2, 0)
gsSP1Triangle(0, 2, 3, 0)
gsSPEndDisplayList()
