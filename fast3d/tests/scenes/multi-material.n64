// multi-material — three quads with distinct materials in one display list:
// opaque textured (OPA_SURF), XLU primitive-color (XLU_SURF), cutout-placeholder textured (TEX_EDGE).
// Phase A: XLU and cutout render opaque (blender=Phase B, alpha-test=Phase D).
// Golden: proves per-material binding — not the old single-material collapse.
Texture tex = { 4, 4, RGBA16 }
Mtx proj = scale(0.0078125)
Mtx model = identity()
Vp { 640, 480, 511, 0, 640, 480, 511, 0 }
// Quad 1 — left third (pixel x 0..32): opaque textured (white shade → shows texture)
Vtx { -128, -128, 0, 0,   0,   0, 255,255,255,255 }
Vtx {  -43, -128, 0, 0, 128,   0, 255,255,255,255 }
Vtx {  -43,  128, 0, 0, 128, 128, 255,255,255,255 }
Vtx { -128,  128, 0, 0,   0, 128, 255,255,255,255 }
// Quad 2 — center third (pixel x 32..64): XLU PRIMITIVE blue (prim-alpha=128, opaque in Phase A)
Vtx {  -43, -128, 0, 0, 0, 0, 255,255,255,255 }
Vtx {   43, -128, 0, 0, 0, 0, 255,255,255,255 }
Vtx {   43,  128, 0, 0, 0, 0, 255,255,255,255 }
Vtx {  -43,  128, 0, 0, 0, 0, 255,255,255,255 }
// Quad 3 — right third (pixel x 64..96): cutout placeholder (orange shade → orange-tinted texture)
Vtx {   43, -128, 0, 0,   0,   0, 255,165,  0,255 }
Vtx {  128, -128, 0, 0, 128,   0, 255,165,  0,255 }
Vtx {  128,  128, 0, 0, 128, 128, 255,165,  0,255 }
Vtx {   43,  128, 0, 0,   0, 128, 255,165,  0,255 }
gsSPMatrix(proj, G_MTX_PROJECTION | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPMatrix(model, G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPViewport(vp)
gsSPSetGeometryMode(G_SHADE | G_SHADING_SMOOTH)
gsDPSetOtherMode_H(G_CYC_1CYCLE)
// --- Material 1: opaque textured --- TEXEL0 x SHADE, G_RM_OPA_SURF
// Establish texture state BEFORE gsSPVertex so UV scale is correct at vertex-load time.
gsDPSetRenderMode(G_RM_OPA_SURF, G_RM_OPA_SURF2)
gsDPSetCombineLERP(TEXEL0, 0, SHADE, 0, 0, 0, 0, SHADE, TEXEL0, 0, SHADE, 0, 0, 0, 0, SHADE)
gsDPSetPrimColor(0, 0, 255, 255, 255, 255)
gsDPSetEnvColor(0, 0, 0, 255)
gsDPLoadTextureBlock(tex, G_IM_FMT_RGBA, G_IM_SIZ_16b, 4, 4)
gsSPTexture(0xFFFF, 0xFFFF, 0, G_TX_RENDERTILE, G_ON)
// Load all 12 vertices (3 quads x 4) into RSP slots 0-11 with correct UV scale.
gsSPVertex(verts, 12, 0)
gsSP1Triangle(0, 1, 2, 0)
gsSP1Triangle(0, 2, 3, 0)
// --- Material 2: XLU flat primitive blue --- PRIMITIVE combiner, G_RM_AA_ZB_XLU_SURF
gsDPSetRenderMode(G_RM_AA_ZB_XLU_SURF, G_RM_AA_ZB_XLU_SURF2)
gsDPSetCombineLERP(0, 0, 0, PRIMITIVE, 0, 0, 0, SHADE, 0, 0, 0, PRIMITIVE, 0, 0, 0, SHADE)
gsDPSetPrimColor(0, 0, 0, 0, 255, 128)
gsSP1Triangle(4, 5, 6, 0)
gsSP1Triangle(4, 6, 7, 0)
// --- Material 3: cutout --- TEXEL0 x SHADE (orange shade), G_RM_AA_ZB_TEX_EDGE.
// Alpha combiner: 0,0,0,TEXEL0 → out_a = TEXEL0.a. CVG_X_ALPHA threshold=0.125:
// texels with alpha=0 (sub-threshold) are discarded (hole); alpha=1 texels are kept (opaque).
gsDPSetRenderMode(G_RM_AA_ZB_TEX_EDGE, G_RM_AA_ZB_TEX_EDGE2)
gsDPSetCombineLERP(TEXEL0, 0, SHADE, 0, 0, 0, 0, TEXEL0, TEXEL0, 0, SHADE, 0, 0, 0, 0, TEXEL0)
gsDPSetPrimColor(0, 0, 255, 255, 255, 255)
gsDPSetEnvColor(0, 0, 0, 255)
gsDPLoadTextureBlock(tex, G_IM_FMT_RGBA, G_IM_SIZ_16b, 4, 4)
gsSPTexture(0xFFFF, 0xFFFF, 0, G_TX_RENDERTILE, G_ON)
gsSP1Triangle(8, 9, 10, 0)
gsSP1Triangle(8, 10, 11, 0)
gsSPEndDisplayList()
