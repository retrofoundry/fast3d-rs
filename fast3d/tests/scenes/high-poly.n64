// high-poly — multi-batch vertex-loading guard (marker uniquely from the post-127 batch).
// 5 × gsSPVertex(verts,28,0) reloads accumulate 140 global entries (> 127) of the blue mesh;
// the 6th batch gsSPVertex(verts,31,0) loads the red marker verts (slots 28-30 — NEVER touched
// by the mesh batches) at global indices 168-170. Global 0-2 hold BLUE mesh corners, so the red
// marker at pixel (10,10) proves the A5 cache→global-index path resolved the post-127 batch
// correctly: a slot-reuse / wrong-index regression would draw blue/background there and FAIL.
Mtx proj  = scale(0.0078125)
Mtx model = identity()
Vp { 640, 480, 511, 0, 640, 480, 511, 0 }
// Mesh body (slots 0-27): blue 4×7 grid at x≥0 (screen x≥48 in a 96×96 render).
Vtx {    0,  128, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   43,  128, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   85,  128, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {  128,  128, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {    0,   85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   43,   85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   85,   85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {  128,   85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {    0,   43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   43,   43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   85,   43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {  128,   43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {    0,    0, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   43,    0, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   85,    0, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {  128,    0, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {    0,  -43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   43,  -43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   85,  -43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {  128,  -43, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {    0,  -85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   43,  -85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   85,  -85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {  128,  -85, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {    0, -128, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   43, -128, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {   85, -128, 0, 0, 0, 0,   0,  50, 200, 255 }
Vtx {  128, -128, 0, 0, 0, 0,   0,  50, 200, 255 }
// Marker (slots 28-30): red, top-left — covers pixel (10,10). Loaded ONLY by the final batch,
// so it lands at global 168-170 (post-127); the mesh batches (count=28) never reach these slots.
Vtx { -128,  128, 0, 0, 0, 0, 255,   0,   0, 255 }
Vtx {  -70,  128, 0, 0, 0, 0, 255,   0,   0, 255 }
Vtx { -128,   70, 0, 0, 0, 0, 255,   0,   0, 255 }

gsSPMatrix(proj, G_MTX_PROJECTION | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPMatrix(model, G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH)
gsSPViewport(vp)
gsSPSetGeometryMode(G_SHADE | G_SHADING_SMOOTH | G_ZBUFFER)
gsDPSetOtherMode_H(G_CYC_1CYCLE)
gsDPSetRenderMode(G_RM_AA_ZB_OPA_SURF, G_RM_AA_ZB_OPA_SURF2)
gsDPSetCombineLERP(0, 0, 0, SHADE, 0, 0, 0, SHADE, 0, 0, 0, SHADE, 0, 0, 0, SHADE)

// Batch 1: global 0-27 — reload the 28 blue mesh verts, draw the grid.
gsSPVertex(verts, 28, 0)
gsSP2Triangles(0, 1, 4, 0, 1, 5, 4, 0)
gsSP2Triangles(1, 2, 5, 0, 2, 6, 5, 0)
gsSP2Triangles(2, 3, 6, 0, 3, 7, 6, 0)
gsSP2Triangles(4, 5, 8, 0, 5, 9, 8, 0)
gsSP2Triangles(5, 6, 9, 0, 6, 10, 9, 0)
gsSP2Triangles(6, 7, 10, 0, 7, 11, 10, 0)
gsSP2Triangles(8, 9, 12, 0, 9, 13, 12, 0)
gsSP2Triangles(9, 10, 13, 0, 10, 14, 13, 0)
gsSP2Triangles(10, 11, 14, 0, 11, 15, 14, 0)
gsSP2Triangles(12, 13, 16, 0, 13, 17, 16, 0)
gsSP2Triangles(13, 14, 17, 0, 14, 18, 17, 0)
gsSP2Triangles(14, 15, 18, 0, 15, 19, 18, 0)
gsSP2Triangles(16, 17, 20, 0, 17, 21, 20, 0)
gsSP2Triangles(17, 18, 21, 0, 18, 22, 21, 0)
gsSP2Triangles(18, 19, 22, 0, 19, 23, 22, 0)
gsSP2Triangles(20, 21, 24, 0, 21, 25, 24, 0)
gsSP2Triangles(21, 22, 25, 0, 22, 26, 25, 0)
gsSP2Triangles(22, 23, 26, 0, 23, 27, 26, 0)

// Batch 2: global 28-55 — reload the 28 blue mesh verts, draw the grid.
gsSPVertex(verts, 28, 0)
gsSP2Triangles(0, 1, 4, 0, 1, 5, 4, 0)
gsSP2Triangles(1, 2, 5, 0, 2, 6, 5, 0)
gsSP2Triangles(2, 3, 6, 0, 3, 7, 6, 0)
gsSP2Triangles(4, 5, 8, 0, 5, 9, 8, 0)
gsSP2Triangles(5, 6, 9, 0, 6, 10, 9, 0)
gsSP2Triangles(6, 7, 10, 0, 7, 11, 10, 0)
gsSP2Triangles(8, 9, 12, 0, 9, 13, 12, 0)
gsSP2Triangles(9, 10, 13, 0, 10, 14, 13, 0)
gsSP2Triangles(10, 11, 14, 0, 11, 15, 14, 0)
gsSP2Triangles(12, 13, 16, 0, 13, 17, 16, 0)
gsSP2Triangles(13, 14, 17, 0, 14, 18, 17, 0)
gsSP2Triangles(14, 15, 18, 0, 15, 19, 18, 0)
gsSP2Triangles(16, 17, 20, 0, 17, 21, 20, 0)
gsSP2Triangles(17, 18, 21, 0, 18, 22, 21, 0)
gsSP2Triangles(18, 19, 22, 0, 19, 23, 22, 0)
gsSP2Triangles(20, 21, 24, 0, 21, 25, 24, 0)
gsSP2Triangles(21, 22, 25, 0, 22, 26, 25, 0)
gsSP2Triangles(22, 23, 26, 0, 23, 27, 26, 0)

// Batch 3: global 56-83 — reload the 28 blue mesh verts, draw the grid.
gsSPVertex(verts, 28, 0)
gsSP2Triangles(0, 1, 4, 0, 1, 5, 4, 0)
gsSP2Triangles(1, 2, 5, 0, 2, 6, 5, 0)
gsSP2Triangles(2, 3, 6, 0, 3, 7, 6, 0)
gsSP2Triangles(4, 5, 8, 0, 5, 9, 8, 0)
gsSP2Triangles(5, 6, 9, 0, 6, 10, 9, 0)
gsSP2Triangles(6, 7, 10, 0, 7, 11, 10, 0)
gsSP2Triangles(8, 9, 12, 0, 9, 13, 12, 0)
gsSP2Triangles(9, 10, 13, 0, 10, 14, 13, 0)
gsSP2Triangles(10, 11, 14, 0, 11, 15, 14, 0)
gsSP2Triangles(12, 13, 16, 0, 13, 17, 16, 0)
gsSP2Triangles(13, 14, 17, 0, 14, 18, 17, 0)
gsSP2Triangles(14, 15, 18, 0, 15, 19, 18, 0)
gsSP2Triangles(16, 17, 20, 0, 17, 21, 20, 0)
gsSP2Triangles(17, 18, 21, 0, 18, 22, 21, 0)
gsSP2Triangles(18, 19, 22, 0, 19, 23, 22, 0)
gsSP2Triangles(20, 21, 24, 0, 21, 25, 24, 0)
gsSP2Triangles(21, 22, 25, 0, 22, 26, 25, 0)
gsSP2Triangles(22, 23, 26, 0, 23, 27, 26, 0)

// Batch 4: global 84-111 — reload the 28 blue mesh verts, draw the grid.
gsSPVertex(verts, 28, 0)
gsSP2Triangles(0, 1, 4, 0, 1, 5, 4, 0)
gsSP2Triangles(1, 2, 5, 0, 2, 6, 5, 0)
gsSP2Triangles(2, 3, 6, 0, 3, 7, 6, 0)
gsSP2Triangles(4, 5, 8, 0, 5, 9, 8, 0)
gsSP2Triangles(5, 6, 9, 0, 6, 10, 9, 0)
gsSP2Triangles(6, 7, 10, 0, 7, 11, 10, 0)
gsSP2Triangles(8, 9, 12, 0, 9, 13, 12, 0)
gsSP2Triangles(9, 10, 13, 0, 10, 14, 13, 0)
gsSP2Triangles(10, 11, 14, 0, 11, 15, 14, 0)
gsSP2Triangles(12, 13, 16, 0, 13, 17, 16, 0)
gsSP2Triangles(13, 14, 17, 0, 14, 18, 17, 0)
gsSP2Triangles(14, 15, 18, 0, 15, 19, 18, 0)
gsSP2Triangles(16, 17, 20, 0, 17, 21, 20, 0)
gsSP2Triangles(17, 18, 21, 0, 18, 22, 21, 0)
gsSP2Triangles(18, 19, 22, 0, 19, 23, 22, 0)
gsSP2Triangles(20, 21, 24, 0, 21, 25, 24, 0)
gsSP2Triangles(21, 22, 25, 0, 22, 26, 25, 0)
gsSP2Triangles(22, 23, 26, 0, 23, 27, 26, 0)

// Batch 5: global 112-139 — reload the 28 blue mesh verts, draw the grid.
gsSPVertex(verts, 28, 0)
gsSP2Triangles(0, 1, 4, 0, 1, 5, 4, 0)
gsSP2Triangles(1, 2, 5, 0, 2, 6, 5, 0)
gsSP2Triangles(2, 3, 6, 0, 3, 7, 6, 0)
gsSP2Triangles(4, 5, 8, 0, 5, 9, 8, 0)
gsSP2Triangles(5, 6, 9, 0, 6, 10, 9, 0)
gsSP2Triangles(6, 7, 10, 0, 7, 11, 10, 0)
gsSP2Triangles(8, 9, 12, 0, 9, 13, 12, 0)
gsSP2Triangles(9, 10, 13, 0, 10, 14, 13, 0)
gsSP2Triangles(10, 11, 14, 0, 11, 15, 14, 0)
gsSP2Triangles(12, 13, 16, 0, 13, 17, 16, 0)
gsSP2Triangles(13, 14, 17, 0, 14, 18, 17, 0)
gsSP2Triangles(14, 15, 18, 0, 15, 19, 18, 0)
gsSP2Triangles(16, 17, 20, 0, 17, 21, 20, 0)
gsSP2Triangles(17, 18, 21, 0, 18, 22, 21, 0)
gsSP2Triangles(18, 19, 22, 0, 19, 23, 22, 0)
gsSP2Triangles(20, 21, 24, 0, 21, 25, 24, 0)
gsSP2Triangles(21, 22, 25, 0, 22, 26, 25, 0)
gsSP2Triangles(22, 23, 26, 0, 23, 27, 26, 0)

// Marker batch: global 140-170 — load 31 verts; the red
// marker (slots 28-30) lands at global 168-170 (post-127, batch-exclusive).
gsSPVertex(verts, 31, 0)
gsSP1Triangle(28, 29, 30, 0)

gsSPEndDisplayList()
