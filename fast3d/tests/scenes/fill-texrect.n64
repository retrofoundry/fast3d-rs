// fill-texrect — 2D demo: FILL mode clears a 64×64 CIMG to a solid blue, then
// a COPY-cycle TEXRECT blits the quad_tex 4×4 checker pattern over the scanout.
//
// Two sub-passes in one display list:
//   1. G_CYC_FILL → gsDPFillRectangle clears the whole 64×64 surface to blue.
//   2. G_CYC_COPY → gsSPTextureRectangle copies the 4×4 checker into the same CIMG.
//
// Scanout CIMG: 64×64 RGBA16 at 0x00100000 (w×2=128 B/row; w×4=256 sub-pixel width).
Texture tex = { 4, 4, RGBA16 }
gsDPSetColorImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, 64, 0x00100000)
gsDPSetScissor(0, 0, 0, 256, 256)
// Pass 1 — FILL mode: clear the buffer to pure blue (RGBA16 0x003F × 2)
gsDPSetOtherMode_H(G_CYC_FILL)
gsDPSetFillColor(0x003F003F)
gsDPFillRectangle(0, 0, 256, 256)
// Pass 2 — COPY mode: blit the 4×4 checker texture across the full 64×64 rect
gsDPSetOtherMode_H(G_CYC_COPY)
gsDPLoadTextureBlock(tex, G_IM_FMT_RGBA, G_IM_SIZ_16b, 4, 4)
gsSPTextureRectangle(0, 0, 256, 256, 0, 0, 0, 1024, 1024)
gsSPEndDisplayList()
